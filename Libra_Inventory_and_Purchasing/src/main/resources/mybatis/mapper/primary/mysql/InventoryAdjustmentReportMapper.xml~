<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.InventoryAdjustmentReportMapper">
    <sql id="BASE_COLUMN_LIST">
        cycle_products.id AS id,
    cycle_products.date AS date,
    (SELECT CONCAT(first_name, ' ', last_name) FROM users WHERE id = 161) AS createBy,
    cycle_products.reference AS reference,
    (SELECT name FROM companies WHERE id = cycle_products.company_id) AS companyName,
    (SELECT name FROM location_groups WHERE id = cycle_products.location_group_id) AS warehouse,
    (SELECT CONCAT(account_codes, " · ", account_description) FROM chart_accounts WHERE id = cycle_products.deposit_to) AS account
    </sql>

    <sql id="BASE_FROM">
        FROM cycle_products
            LEFT JOIN cycle_product_details ON cycle_products.id = cycle_product_details.product_id
    </sql>

    <sql id="BASE_WHERE">
        WHERE cycle_products.status > 0
        AND cycle_products.company_id IN (SELECT company_id FROM user_companies WHERE user_id = 161)
            <if test="filter.dateFrom != null">
                AND cycle_products.date >= #{filter.dateFrom}
            </if>
            <if test="filter.dateTo != null">
                AND cycle_products.date  &lt;=  #{filter.dateTo}
            </if>
            <if test="filter.companyId != null">
                AND cycle_products.company_id= #{filter.companyId}
            </if>
            <if test="filter.locationGroupId != null">
                AND cycle_products.location_group_id = #{filter.locationGroupId}
            </if>
            <if test="filter.productId != null">
                AND cycle_product_details.product_id = #{filter.productId}
            </if>
            <if test="filter.createdBy != null">
                AND cycle_products.created_by = #{filter.createdBy}
            </if>
    </sql>

    <select id="getList" parameterType="com.ut.nlSystemAPi.model.filter.InventoryAdjustmentReportFilter" resultMap="InventoryAdjustmentReportResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST" />
        <include refid="BASE_FROM" />
        <include refid="BASE_WHERE" />
        ORDER BY
        <choose>
            <when test="filter.orderBy != null">
                ${filter.orderBy}
            </when>
            <otherwise>
                cycle_products.id DESC
            </otherwise>
        </choose>
        <if test="filter.page != null and filter.rowsPerPage != null">LIMIT #{filter.page}, #{filter.rowsPerPage}</if>
    </select>

    <select id="countList" parameterType="com.ut.nlSystemAPi.model.filter.TransferOrderReportFilter" resultType="java.lang.Long">
        SELECT COUNT(cycle_products.id)
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
    </select>


    //list by item
    <sql id="BASE_COLUMN_LIST_BY_ITEM">
             transfer_orders.id,
             CONCAT_WS(' ', p.code, p.name) AS productName,
             transfer_orders.to_code AS toNumber,
             lg_from.name AS fromWareHouse,
             lg_to.name AS toWareHouse,
           (transfer_order_details.qty * transfer_order_details.conversion) AS qty,
                 (SELECT price_uom_id FROM products WHERE id = transfer_order_details.product_id) AS qty_uom_id,
            transfer_order_details.conversion,
                  (SELECT name FROM uoms WHERE id = qty_uom_id) AS qtyUomName, (SELECT cost FROM inventory_valuations
                  WHERE is_active = 1 AND pid = transfer_order_details.product_id AND date >= transfer_orders.order_date
                 ORDER BY date DESC, created DESC, id DESC LIMIT 1) AS totalCost
    </sql>
    <sql id="BASE_FROM_BY_ITEM">
         FROM transfer_orders
            INNER JOIN transfer_order_details ON transfer_orders.id = transfer_order_details.transfer_order_id
            INNER JOIN   products p ON p.id = transfer_order_details.product_id
           LEFT JOIN   location_groups lg_from ON lg_from.id = transfer_orders.from_location_group_id
           LEFT JOIN  location_groups lg_to ON lg_to.id = transfer_orders.to_location_group_id
    </sql>

    <sql id="BASE_WHERE_BY_ITEM">
        <where>
            <if test="filterByItem.dateFrom != null">
                AND transfer_orders.order_date &gt;= #{filterByItem.dateFrom}
            </if>
            <if test="filterByItem.dateTo != null">
                AND transfer_orders.order_date &lt;= #{filterByItem.dateTo}
            </if>
            <if test="filterByItem.fromWareHouse != null">
                AND transfer_orders.from_location_group_id = #{filterByItem.fromWareHouse}
            </if>
            <if test="filterByItem.toWareHouse != null">
                AND transfer_orders.to_location_group_id = #{filterByItem.toWareHouse}
            </if>
            <if test="filterByItem.productGroup != null">
                AND transfer_order_details.product_id IN
                (SELECT id FROM products WHERE pgroup_id = #{filterByItem.productGroup})
            </if>
            <if test="filterByItem.parentId != null">
                AND (SELECT parent_id FROM products WHERE id = transfer_order_details.product_id) = #{filterByItem.parentId}
            </if>
            <if test="filterByItem.productId != null">
                AND transfer_order_details.product_id = #{filterByItem.productId}
            </if>
            <if test="filterByItem.createBy != null">
                AND transfer_orders.created_by = #{filterByItem.createBy}
            </if>
        </where>
    </sql>

    <select id="getListByItemSummary" parameterType="com.ut.nlSystemAPi.model.filter.TransferOrderReportByItemFilter" resultMap="TransferOrderReportByItemResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST_BY_ITEM" />
        <include refid="BASE_FROM_BY_ITEM" />
        <include refid="BASE_WHERE_BY_ITEM" />
        ORDER BY
        <choose>
            <when test="filterByItem.orderBy != null">
                ${filterByItem.orderBy}
            </when>
            <otherwise>
                transfer_orders.id DESC
            </otherwise>
        </choose>
        <if test="filterByItem.page != null and filterByItem.rowsPerPage != null">LIMIT #{filterByItem.page}, #{filterByItem.rowsPerPage}</if>
    </select>

    <select id="countListByItemSummary" parameterType="com.ut.nlSystemAPi.model.filter.TransferOrderReportByItemFilter" resultType="java.lang.Long">
        SELECT COUNT(transfer_orders.id)
        <include refid="BASE_FROM_BY_ITEM" />
        <include refid="BASE_WHERE_BY_ITEM" />
    </select>

    <select id="getListProduct" parameterType="com.ut.nlSystemAPi.model.filter.TransferOrderReportByItemFilter" resultMap="TransferOrderReportDetailResponse">
         SELECT
          product_id AS productId,
             (SELECT CONCAT_WS(' ',code,name) FROM products WHERE id=product_id) AS productName
                 FROM transfer_orders
                 INNER JOIN transfer_order_details ON transfer_orders.id=transfer_order_details.transfer_order_id
                GROUP BY product_id
    </select>

    <select id="getListDetail"  resultMap="TransferOrderReportByItemResponse">
        SELECT
                transfer_orders.id AS id,
                'Tranfer Order' AS type,
                CONCAT_WS(' ', products.code, products.name) AS productName,
                transfer_orders.order_date AS date,
                transfer_orders.to_code AS toNumber,
                lg_from.name AS fromWareHouse,
               lg_to.name AS toWareHouse,
                (transfer_order_details.qty * transfer_order_details.conversion) AS qty,
                uoms.name AS qtyUomName,
                (SELECT cost FROM inventory_valuations WHERE is_active=1 AND pid=product_id AND date = order_date ORDER BY date DESC,created DESC,id DESC LIMIT 1) AS unitCost
                FROM transfer_orders
                    INNER JOIN transfer_order_details ON transfer_orders.id=transfer_order_details.transfer_order_id
                    LEFT JOIN products ON products.id=transfer_order_details.product_id
                    LEFT JOIN  location_groups lg_from ON lg_from.id = transfer_orders.from_location_group_id
                   LEFT JOIN location_groups lg_to ON lg_to.id = transfer_orders.to_location_group_id
                   LEFT JOIN uoms ON uoms.id=transfer_order_details.qty_uom_id
                   WHERE product_id = #{productId}
    </select>
    <select id="getListParentIdProduct"   parameterType="com.ut.nlSystemAPi.model.filter.TransferOrderReportByItemFilter" resultMap="TransferOrderReportDetailResponse">
        SELECT
             parent.id AS productId,
             parent.name AS productName
                  FROM transfer_order_details
                 INNER JOIN products AS parent ON parent.parent_id = transfer_order_details.product_id
                 GROUP BY transfer_order_details.product_id
    </select>

    <select id="getListDetailByParentId" resultMap="TransferOrderReportByItemResponse">
        SELECT
            transfer_orders.id AS id,
            'Tranfer Order' AS type,
            CONCAT_WS(' ', products.code, products.name) AS productName,
              transfer_orders.order_date AS date,
              transfer_orders.to_code AS toNumber,
              lg_from.name AS fromWareHouse,
              lg_to.name AS toWareHouse,
             (transfer_order_details.qty * transfer_order_details.conversion) AS qty,
            uoms.name AS qtyUomName,
                 (SELECT cost FROM inventory_valuations WHERE is_active=1 AND pid=product_id AND date = order_date ORDER BY date DESC,created DESC,id DESC LIMIT 1) AS unitCost
         FROM transfer_orders
                INNER JOIN transfer_order_details ON transfer_orders.id=transfer_order_details.transfer_order_id
                LEFT JOIN products ON products.id=transfer_order_details.product_id
                LEFT JOIN  location_groups lg_from ON lg_from.id = transfer_orders.from_location_group_id
                LEFT JOIN location_groups lg_to ON lg_to.id = transfer_orders.to_location_group_id
                LEFT JOIN uoms ON uoms.id=transfer_order_details.qty_uom_id
               WHERE   product_id = #{parentId}
        <if test="filterByItem.dateFrom != null">
            AND transfer_orders.order_date &gt;= #{filterByItem.dateFrom}
        </if>
        <if test="filterByItem.dateTo != null">
            AND transfer_orders.order_date &lt;= #{filterByItem.dateTo}
        </if>
        <if test="filterByItem.fromWareHouse != null">
            AND transfer_orders.from_location_group_id = #{filterByItem.fromWareHouse}
        </if>
        <if test="filterByItem.toWareHouse != null">
            AND transfer_orders.to_location_group_id = #{filterByItem.toWareHouse}
        </if>
        <if test="filterByItem.productGroup != null">
            AND transfer_order_details.product_id IN
            (SELECT id FROM products WHERE pgroup_id = #{filterByItem.productGroup})
        </if>
        <if test="filterByItem.parentId != null">
            AND (SELECT parent_id FROM products WHERE id = transfer_order_details.product_id) = #{filterByItem.parentId}
        </if>
        <if test="filterByItem.productId != null">
            AND transfer_order_details.product_id = #{filterByItem.productId}
        </if>
        <if test="filterByItem.createBy != null">
            AND transfer_orders.created_by = #{filterByItem.createBy}
        </if>

    </select>

</mapper>