<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.SettingMapper">

  <select id="emailSetting" resultMap="EmailSetting">
    SELECT host, port, username, password
    FROM `setting_emails`
    WHERE 1;
  </select>

  <select id="smsSetting" resultMap="SmsSetting">
    SELECT tc, sc
    FROM `setting_sms_configs`
    WHERE 1;
  </select>

  <select id="apnsProvider" resultMap="ApnsProvider">
    SELECT *
    FROM `setting_apns_providers`
    WHERE id = 2;
  </select>

</mapper>