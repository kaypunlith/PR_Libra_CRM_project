<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.TermPrivacyMapper">

    <resultMap id="TermPrivacyResponse" type="com.ut.nlSystemAPi.model.response.TermPrivacy.TermPrivacyResponse">
        <id property="id" column="id"/>
        <result property="descriptionPrivacyKh" column="descriptionPrivacyKh"/>
        <result property="descriptionPrivacyEn" column="descriptionPrivacyEn"/>
        <result property="descriptionTermsKh" column="descriptionTermsKh"/>
        <result property="descriptionTermsEn" column="descriptionTermsEn"/>
        <result property="created" column="created"/>
        <result property="createdBy" column="createdBy"/>
        <result property="modified" column="modified"/>
        <result property="modifiedBy" column="modifiedBy"/>
    </resultMap>

    <sql id="BASE_COLUMN_LIST">
        privacy_and_terms.id AS id,
        privacy_and_terms.description_privacy_kh AS descriptionPrivacyKh,
        privacy_and_terms.description_privacy_en AS descriptionPrivacyEn,
        privacy_and_terms.description_terms_kh AS descriptionTermsKh,
        privacy_and_terms.description_terms_en AS descriptionTermsEn
    </sql>

    <sql id="BASE_FROM">
        FROM privacy_and_terms
    </sql>

    <sql id="BASE_WHERE">
        WHERE privacy_and_terms.is_active = 1 AND privacy_and_terms.id = 1
    </sql>

    <select id="getList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultMap="TermPrivacyResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST"/>
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
    </select>

    <update id="update" parameterType="com.ut.nlSystemAPi.model.entity.TermPrivacy.TermPrivacy">
        UPDATE privacy_and_terms SET
            <if test="termPrivacy.descriptionPrivacyKh != null">description_privacy_kh = #{termPrivacy.descriptionPrivacyKh},</if>
            <if test="termPrivacy.descriptionPrivacyEn != null">description_privacy_en = #{termPrivacy.descriptionPrivacyEn},</if>
            <if test="termPrivacy.descriptionTermsKh != null">description_terms_kh = #{termPrivacy.descriptionTermsKh},</if>
            <if test="termPrivacy.descriptionTermsEn != null">description_terms_en = #{termPrivacy.descriptionTermsEn},</if>
            modified = NOW(),
            modified_by = #{termPrivacy.modifiedBy}
        WHERE id = 1 AND is_active = 1
    </update>
</mapper>
