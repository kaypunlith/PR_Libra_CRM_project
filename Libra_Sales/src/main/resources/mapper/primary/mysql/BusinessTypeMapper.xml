<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.BusinessTypeMapper">

    <resultMap id="BusinessTypeResponse" type="com.ut.nlSystemAPi.model.response.BusinessType.BusinessTypeResponse">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <sql id="BASE_COLUMN_LIST">
        id,
        `name`
    </sql>

    <sql id="BASE_FROM">
        FROM customer_types
    </sql>

    <sql id="BASE_WHERE">
        WHERE is_active = 1
        <if test="filter.searchText != null">
            AND name LIKE CONCAT("%", #{filter.searchText}, "%")
        </if>
    </sql>

    <select id="getList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultMap="BusinessTypeResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST"/>
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
        ORDER BY
        <choose>
            <when test="filter.orderBy != null">
                ${filter.orderBy}
            </when>
            <otherwise>
                `name` ASC
            </otherwise>
        </choose>
        <if test="filter.page != null and filter.rowsPerPage != null">
            LIMIT #{filter.page}, #{filter.rowsPerPage}
        </if>
    </select>

    <select id="countList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultType="java.lang.Long">
        SELECT COUNT(id)
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
    </select>

    <select id="getOne" parameterType="java.lang.Long" resultMap="BusinessTypeResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST"/>
        <include refid="BASE_FROM"/>
        WHERE is_active = 1 AND id = #{id}
    </select>

    <insert id="insert" parameterType="com.ut.nlSystemAPi.model.entity.BusinessType.BusinessType" useGeneratedKeys="true" keyProperty="businessType.id">
        INSERT INTO customer_types (
            `name`,
            created,
            created_by,
            is_active
        ) VALUES (
            #{businessType.name},
            NOW(),
            #{businessType.createdBy},
            #{businessType.isActive}
        )
    </insert>

    <update id="update" parameterType="com.ut.nlSystemAPi.model.entity.BusinessType.BusinessType">
        UPDATE customer_types SET
            <if test="businessType.name != null">`name` = #{businessType.name},</if>
            modified = NOW(),
            modified_by = #{businessType.modifiedBy}
        WHERE id = #{businessType.id} AND is_active = 1
    </update>

    <update id="delete" parameterType="java.lang.Long">
        UPDATE customer_types SET
            is_active = 2,
            modified = NOW(),
            modified_by = #{userId}
        WHERE id = #{id} AND is_active = 1
    </update>
</mapper>