<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.AboutUsMapper">

    <resultMap id="AboutUsResponse" type="com.ut.nlSystemAPi.model.response.AboutUs.AboutUsResponse">
        <id property="id" column="id"/>
        <result property="descriptionKh" column="descriptionKh"/>
        <result property="descriptionEn" column="descriptionEn"/>
        <result property="created" column="created"/>
        <result property="createdBy" column="createdBy"/>
        <result property="modified" column="modified"/>
        <result property="modifiedBy" column="modifiedBy"/>
    </resultMap>

    <sql id="BASE_COLUMN_LIST">
        about_us.id AS id,
        about_us.description_kh AS descriptionKh,
        about_us.description_en AS descriptionEn
    </sql>

    <sql id="BASE_FROM">
        FROM about_us
    </sql>

    <sql id="BASE_WHERE">
        WHERE about_us.is_active = 1 AND about_us.id = 1
    </sql>

    <select id="getList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultMap="AboutUsResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST"/>
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
    </select>

    <update id="update" parameterType="com.ut.nlSystemAPi.model.entity.AboutUs.AboutUs">
        UPDATE about_us SET
            <if test="aboutUs.descriptionKh != null">description_kh = #{aboutUs.descriptionKh},</if>
            <if test="aboutUs.descriptionEn != null">description_en = #{aboutUs.descriptionEn},</if>
            modified = NOW(),
            modified_by = #{aboutUs.modifiedBy}
        WHERE id = 1 AND is_active = 1
    </update>
</mapper>
