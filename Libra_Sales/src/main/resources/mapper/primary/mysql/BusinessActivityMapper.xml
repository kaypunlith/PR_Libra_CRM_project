<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.BusinessActivityMapper">

    <resultMap id="BusinessActivityResponse" type="com.ut.nlSystemAPi.model.response.BusinessActivity.BusinessActivityResponse">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="abbr" column="abbr"/>
    </resultMap>

    <sql id="BASE_COLUMN_LIST">
        id,
        `name`,
        abbr
    </sql>

    <sql id="BASE_FROM">
        FROM customer_activities
    </sql>

    <sql id="BASE_WHERE">
        WHERE is_active = 1
        <if test="filter.searchText != null">
            AND name LIKE CONCAT("%", #{filter.searchText}, "%")
        </if>
    </sql>

    <select id="getList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultMap="BusinessActivityResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST"/>
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
        ORDER BY
        <choose>
            <when test="filter.orderBy != null">
                ${filter.orderBy}
            </when>
            <otherwise>
                `name` ASC
            </otherwise>
        </choose>
        <if test="filter.page != null and filter.rowsPerPage != null">
            LIMIT #{filter.page}, #{filter.rowsPerPage}
        </if>
    </select>

    <select id="countList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultType="java.lang.Long">
        SELECT COUNT(id)
        <include refid="BASE_FROM"/>
        <include refid="BASE_WHERE"/>
    </select>

    <select id="getOne" parameterType="java.lang.Long" resultMap="BusinessActivityResponse">
        SELECT
        <include refid="BASE_COLUMN_LIST"/>
        <include refid="BASE_FROM"/>
        WHERE is_active = 1 AND id = #{id}
    </select>

    <insert id="insert" parameterType="com.ut.nlSystemAPi.model.entity.BusinessActivity.BusinessActivity" useGeneratedKeys="true" keyProperty="businessActivity.id">
        INSERT INTO customer_activities (
            `name`,
            abbr,
            created,
            created_by,
            is_active
        ) VALUES (
            #{businessActivity.name},
            #{businessActivity.abbr},
            NOW(),
            #{businessActivity.createdBy},
            #{businessActivity.isActive}
        )
    </insert>

    <update id="update" parameterType="com.ut.nlSystemAPi.model.entity.BusinessActivity.BusinessActivity">
        UPDATE customer_activities SET
            <if test="businessActivity.name != null">`name` = #{businessActivity.name},</if>
            <if test="businessActivity.abbr != null">`abbr` = #{businessActivity.abbr},</if>
            modified = NOW(),
            modified_by = #{businessActivity.modifiedBy}
        WHERE id = #{businessActivity.id} AND is_active = 1
    </update>

    <update id="delete" parameterType="java.lang.Long">
        UPDATE customer_activities SET
            is_active = 2,
            modified = NOW(),
            modified_by = #{userId}
        WHERE id = #{id} AND is_active = 1
    </update>
</mapper>