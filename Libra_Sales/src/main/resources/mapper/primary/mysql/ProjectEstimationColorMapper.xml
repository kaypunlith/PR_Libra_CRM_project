<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ut.nlSystemAPi.mapper.primary.ProjectEstimationColorMapper">

  <resultMap id="ProjectEstimationColorResponse" type="com.ut.nlSystemAPi.model.response.ProjectEstimationColor.ProjectEstimationColorResponse">
    <id property="id" column="id"/>
    <result property="name" column="color"/>
    <result property="code" column="color_code"/>
    <result property="percentFrom" column="percent_from"/>
    <result property="percentTo" column="percent_to"/>
  </resultMap>

  <sql id="BASE_COLUMN_LIST">
    id,
    `color`,
    color_code,
    percent_from,
    percent_to
  </sql>

  <sql id="BASE_FROM">
    FROM project_costing_percent_setting_colors
  </sql>

  <sql id="BASE_WHERE">
    WHERE is_active = 1
    <if test="filter.searchText != null">
        AND color LIKE CONCAT("%", #{filter.searchText}, "%")
     </if>
  </sql>

  <select id="getList" parameterType="com.ut.nlSystemAPi.model.filter.ProjectEstimationFilter" resultMap="ProjectEstimationColorResponse">
    SELECT
    <include refid="BASE_COLUMN_LIST"/>
    <include refid="BASE_FROM"/>
    <include refid="BASE_WHERE"/>
    ORDER BY
    <choose>
      <when test="filter.orderBy != null">
        ${filter.orderBy}
      </when>
      <otherwise>
        color ASC
      </otherwise>
    </choose>
    <if test="filter.page != null and filter.rowsPerPage != null">
      LIMIT #{filter.page}, #{filter.rowsPerPage}
    </if>
  </select>

  <select id="countList" parameterType="com.ut.nlSystemAPi.model.base.Filter" resultType="java.lang.Long">
    SELECT COUNT(id)
    <include refid="BASE_FROM"/>
    <include refid="BASE_WHERE"/>
  </select>

  <select id="getOne" parameterType="java.lang.Long" resultMap="ProjectEstimationColorResponse">
    SELECT
    <include refid="BASE_COLUMN_LIST"/>
    <include refid="BASE_FROM"/>
    WHERE is_active = 1 AND id = #{id}
  </select>

  <select id="checkDuplicate" resultType="java.lang.Long">
    SELECT COUNT(id)
    FROM project_costing_percent_setting_colors
    WHERE is_active = 1
    AND color = #{name}
    <if test="id != null"> AND id != #{id} </if>
  </select>

  <insert id="insert" parameterType="com.ut.nlSystemAPi.model.entity.ProjectEstimationColor.ProjectEstimationColor" useGeneratedKeys="true" keyProperty="color.id">
    INSERT INTO project_costing_percent_setting_colors (
      color,
      color_code,
      percent_from,
      percent_to,
      created,
      created_by,
      is_active
    ) VALUES (
               #{color.color},
               #{color.code},
               #{color.percentFrom},
               #{color.percentTo},
               NOW(),
               #{color.createdBy},
               #{color.isActive}
             )
  </insert>

  <update id="update" parameterType="com.ut.nlSystemAPi.model.entity.ProjectEstimationColor.ProjectEstimationColor">
    UPDATE project_costing_percent_setting_colors SET
    <if test="color.color != null">color = #{color.color},</if>
    <if test="color.code != null">color_code = #{color.code},</if>
    <if test="color.percentFrom != null">percent_from = #{color.percentFrom},</if>
    <if test="color.percentTo != null">percent_to = #{color.percentTo},</if>
    modified = NOW(),
    modified_by = #{color.modifiedBy}
    WHERE id = #{color.id} AND is_active = 1
  </update>

  <update id="delete" parameterType="java.lang.Long">
    UPDATE project_costing_percent_setting_colors SET
    is_active = 2,
    modified = NOW(),
    modified_by = #{userId}
    WHERE id = #{id} AND is_active = 1
  </update>
</mapper>